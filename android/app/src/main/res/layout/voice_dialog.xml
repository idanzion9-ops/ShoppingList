<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/voice_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#88000000"
    android:clickable="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/voice_card_bg"
        android:clickable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛒 מה להוסיף לרשימה?"
            android:textColor="#1A2421"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/voice_heard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:minHeight="36dp"
            android:textColor="#0F766E"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/voice_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="מתחבר…"
            android:textColor="#6B7A76"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/voice_mic"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/voice_mic_bg"
            android:gravity="center"
            android:text="🎤"
            android:textSize="38sp" />

        <ProgressBar
            android:id="@+id/voice_level"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="18dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressTint="#14B8A6"
            android:progressBackgroundTint="#D5E3E0" />

        <TextView
            android:id="@+id/voice_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="10dp"
            android:text="ביטול"
            android:textColor="#6B7A76"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/voice_debug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="#93A39F"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/voice_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:padding="10dp"
            android:text="🔄 החלף שירות דיבור"
            android:textColor="#0F766E"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
